# .env.example — copy this file to .env and fill in real values
# .env is listed in .gitignore and must NEVER be committed to version control.
#
# Generate a secure random value with:
#   Python : python -c "import secrets; print(secrets.token_hex(32))"
#   OpenSSL: openssl rand -hex 32

JWT_SECRET_KEY=replace_with_a_secure_random_secret
